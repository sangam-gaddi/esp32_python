/*
 * TEMPLATE -- the device's cryptographic trust anchors.
 *
 * Do not edit this file. Generate the real one:
 *
 *     python tools/generate_keys.py --write-device-config
 *
 * which writes main/crypto_config.h (git-ignored) from the keys in keys/.
 * If you would rather do it by hand, copy this file to main/crypto_config.h and
 * paste in the values printed by generate_keys.py.
 *
 * ---------------------------------------------------------------------------
 * WHAT BELONGS HERE, AND WHAT MUST NEVER
 * ---------------------------------------------------------------------------
 *
 *   OTA_TRUSTED_ED25519_PUBLIC_KEY  32 bytes, PUBLIC.
 *       The root of trust. The device accepts firmware only if the package
 *       signature verifies under this key. Embedding it is exactly right --
 *       a public key is not a secret, and hard-coding it is what stops an
 *       attacker supplying their own.
 *
 *       Critically, the device must never accept a public key that arrives
 *       *with* the package. That would reduce the signature to a checksum the
 *       attacker can recompute.
 *
 *   OTA_DEFAULT_ENCRYPTION_KEY      16 bytes, SECRET.
 *       The Ascon-AEAD128 key, shared with the packaging tool. It is used once,
 *       on first boot, to provision NVS (main/device_keys.c), after which the
 *       NVS copy is authoritative.
 *
 *       Compiling a shared secret into a firmware image is a DEMONSTRATION
 *       SHORTCUT, not a design. Anyone who can read the flash can read the key.
 *       A real product would provision a per-device key at manufacture into
 *       eFuse or NVS-encrypted storage, with flash encryption enabled, and
 *       never place it in a build artefact. docs/SECURITY.md sets this out.
 *
 *   THE ED25519 PRIVATE KEY
 *       Must never appear in this file, in main/, or anywhere in the firmware.
 *       It lives on the signing host only (keys/ed25519_private.pem). A device
 *       that can sign firmware can authorise its own updates, which defeats the
 *       entire scheme.
 */

#ifndef CRYPTO_CONFIG_H_
#define CRYPTO_CONFIG_H_

#include <stdint.h>

/* Ed25519 public key, 32 bytes, raw (not PEM).
 * Replace with the "raw public key" value from generate_keys.py. */
static const uint8_t OTA_TRUSTED_ED25519_PUBLIC_KEY[32] = {
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
};

/* Ascon-AEAD128 key, 16 bytes. Demonstration provisioning secret. */
static const uint8_t OTA_DEFAULT_ENCRYPTION_KEY[16] = {
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
};

#endif /* CRYPTO_CONFIG_H_ */
